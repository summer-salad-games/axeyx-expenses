# Root-owned 0600 file, read by systemd. Never commit a filled-in version.
APP_ENV=production
BACKUP_STATE_PATH=/var/lib/axeyx-expenses/backup-state
BACKUP_WORKSPACE=/var/lib/axeyx-expenses/backup-work
STORAGE_LOCK_PATH=/var/lib/axeyx-expenses/coordination/consistency.lock
RCLONE_CONFIG=/var/lib/axeyx-expenses/backup-config/rclone.conf
BACKUP_REMOTE=proxymed-drive:proxymed-backups
APP_RELEASE=REPLACE_WITH_DEPLOYED_GIT_COMMIT
