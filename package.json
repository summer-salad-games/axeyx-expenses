{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:server": "LOG_CHANNEL=stack LOG_STACK=single,stderr LOG_LEVEL=debug php artisan serve --no-reload --host=127.0.0.1 --port=8000",
        "db:reset": "php artisan migrate:fresh --seed && php artisan optimize:clear",
        "accounts:create": "php artisan accounts:create",
        "accounts:list": "php artisan accounts:list",
        "accounts:role": "php artisan accounts:role",
        "accounts:disable": "php artisan accounts:disable",
        "accounts:password": "php artisan accounts:password",
        "accounts:mfa-reset": "php artisan accounts:mfa-reset",
        "attachments:reconcile": "php artisan attachments:reconcile",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.1",
        "vite": "^8.0.0",
        "@playwright/test": "^1.0"
    },
    "dependencies": {
        "laravel-echo": "^2.0",
        "pusher-js": "^8.0"
    }
}
